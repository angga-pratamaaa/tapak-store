# Salin menjadi .env di VM srv-web. Jangan commit .env ke Git.
# MySQL di VM db-primary, user khusus aplikasi (bukan root).
# Kata sandi dengan karakter khusus harus di-URL-encode (mis. @ menjadi %40).
DATABASE_URL=mysql://toko:GANTI_PASSWORD@192.168.30.10:3306/toko
SECRET_KEY=ganti-dengan-string-acak-panjang
PORT=5000
# Berkas log (dibaca Wazuh Agent). Di Docker: mount /var/log/toko ke /srv/logs.
LOG_FILE=/srv/logs/app.log

# Kerentanan sengaja untuk uji lab. 1 = rentan, 0 = aman.
VULN_SQLI=1
VULN_IDOR=1
VULN_XSS=1
VULN_PRICE=1
VULN_ADMIN=0
